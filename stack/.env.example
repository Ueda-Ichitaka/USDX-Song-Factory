# Copy this file to .env (same folder as docker-compose.yml) and fill in
# the values you want to override. docker compose loads .env automatically
# for ${VAR} substitution - no extra flags needed.

# Optional: enables the Genius.com lyrics source (in addition to the
# free, no-key syncedlyrics lookup that's always tried first).
# Get a key at https://genius.com/api-clients -> "Client Access Token".
GENIUS_API_KEY=

# Set to 0 to disable the online-lyrics-for-new-songs step entirely
# (whisper's own transcription is then always kept).
#LYRICS_ENABLED=1

# Set to 0 to disable automatic lyrics romanization (Cyrillic/Korean/Japanese).
#ROMANIZE=1

# Resource budget for this stack - drives model/quality auto-selection
# (whisper model + batch size, demucs separation model). Defaults below
# match this host's actual measured budget (see stack/README.md "Resource
# budget"); change them if you move the stack to different hardware.
#STACK_RAM_GB=8
#STACK_SWAP_GB=250
#STACK_CPU_CORES=16
# Only meaningful for the ROCm (GPU) service - demucs separation is the
# only thing that actually uses the GPU here (whisper always runs on CPU).
#STACK_VRAM_GB=16

# Safety margin subtracted from RAM/VRAM before they're used to pick a
# model - a GPU is rarely ALL available to this stack alone (monitors, a
# desktop compositor, browser, ...). Raise these if you still see memory
# pressure; defaults are a starting point, not a guarantee.
#STACK_RAM_SAFETY_MARGIN_GB=1.5
#STACK_VRAM_SAFETY_MARGIN_GB=2

# Force a specific model/batch size instead of the resource-based
# auto-selection above (leave unset to let auto-selection decide).
#WHISPER_MODEL=large-v2
#DEMUCS_MODEL=htdemucs
#WHISPER_BATCH_SIZE=16
